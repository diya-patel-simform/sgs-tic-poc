# Azure Blob Storage — source document store for the TICBot POC
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=

# Azure AI Document Intelligence (Layout model) — used to parse PDFs/scanned pages
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=

# Azure AI Search — index used for retrieval/citation testing
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_ADMIN_KEY=
AZURE_SEARCH_INDEX_NAME=ticbot-chunks
# Default retrieval mode for rag_service.answer() / the Streamlit UI.
# "vector" (the default) was far more reliable than keyword-only search in
# manual testing; "hybrid" (keyword + vector fusion) is kept available for
# later re-testing once Azure's semantic ranker is wired up and more
# documents are indexed. Keyword-only is not offered as a deployment
# default at all.
# RETRIEVAL_MODE=vector

# Azure OpenAI — embeddings for the vector side of hybrid search, and (optionally)
# a chat deployment for the LLM classifier fallback / answering-model eval step
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_CHAT_DEPLOYMENT=
# Optional: overrides the embedding vector width used for the Azure AI Search
# vector field. Defaults to the known output size of AZURE_OPENAI_EMBEDDING_DEPLOYMENT
# (3072 for text-embedding-3-large) — set this only if the deployment is called
# with a shortened `dimensions` value, or its name isn't one of the known models.
AZURE_OPENAI_EMBEDDING_DIMENSIONS=

# Chunk size / overlap tuning (all in tokens, text-embedding-3 tokenizer).
# Defaults match section 2 of TICbot_Chunking_Strategy_Answers.md; uncomment
# to override without touching code.
# CHUNK_NARRATIVE_MIN_TOKENS=60
# CHUNK_NARRATIVE_TARGET_TOKENS=400
# CHUNK_NARRATIVE_MAX_TOKENS=700
# CHUNK_NARRATIVE_OVERLAP_MAX_TOKENS=60
# CHUNK_TABLE_MAX_TOKENS=550
# CHUNK_NABL_MAX_TOKENS=450
# CHUNK_EXCEL_MAX_TOKENS=450
